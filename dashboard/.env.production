# Production-build overrides (loaded by `npm run build`, not by `npm run dev`).

# Sub-path the app is hosted under. The IIS deployment runs it as an Application with alias
# "shotsense", so every asset, client route and API call must be prefixed with it.
# Must start AND end with "/". Blank/removed = hosted at the site root; rebuild after changing.
VITE_BASE_PATH=/shotsense/
