{
  "PLC": {
    "IpAddress": "192.168.0.180",
    "Rack": 0,
    "Slot": 1,
    "DisconnectAfterFailedScans": 2
  },

  "PostgreSQL": {
    "ConnectionString": "Host=localhost;Port=5432;Database=sreesakthi_gateway;Username=postgres;Password=Pass"
  },

  "ConnectionStrings": {
    "PostgresDb": "Host=localhost;Port=5432;Database=sreesakthi_gateway;Username=postgres;Password=Pass"
  },

  "Jwt": {
    "Key": "REPLACE_WITH_A_32+_CHAR_SECRET_AT_DEPLOYMENT",
    "Issuer": "plc-gateway-auth",
    "Audience": "plc-dashboard"
  },

  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "admin123"
  },

  "Admin": {
    "AllowedIps": [ "127.0.0.1", "::1", "REPLACE_WITH_CLOUD_EGRESS_IP" ],
    "ApiKey": "REPLACE_WITH_ADMIN_API_KEY_AT_DEPLOYMENT"
  },

  "License": {
    "CheckUrl": "",
    "Key": "REPLACE_WITH_LICENSE_KEY_AT_DEPLOYMENT",
    "CheckIntervalMinutes": 60,
    "GraceHours": 72
  },

  "ScanIntervalMs": 1000,

  "DataCollection": {
    "CovDeadbandPercent": 2.0,
    "PeriodicHeartbeatSeconds": 60,
    "StringMaxLength": 254,
    "HeartbeatTags": [
      "Machine status", "Blast ON/OFF", "Tonnage", "Refil shots weight",
      "Current_imp_1", "Current_imp_2", "Current_imp_3", "Current_imp_4", "Current_imp_5",
      "Current_imp_6", "Current_imp_7", "Current_imp_8", "Current_imp_9", "Current_imp_10",
      "Casting metal 1 name", "Casting metal 2 name", "Casting metal 3 name", "Casting metal 4 name",
      "Casting metal 1 weight", "Casting metal 2 weight", "Casting metal 3 weight", "Casting metal 4 weight"
    ],
    "StorageRules": {
      "Numeric": "COV_OR_PERIODIC",
      "Bool": "STATE_CHANGE_ONLY",
      "String": "VALUE_CHANGE_ONLY"
    }
  },

  "CovRules": {
    "AbsoluteByName": {
      "Tonnage": 1,
      "Refil shots weight": 1,
      "Casting metal 1 weight": 1,
      "Casting metal 2 weight": 1,
      "Casting metal 3 weight": 1,
      "Casting metal 4 weight": 1
    },
    "AbsoluteByPrefix": {
      "Spares_Runhour_": 0.1
    }
  },

  "Aggregation": {
    "LongTermAggregationDays": [30, 60, 90, 365],
    "AggregationSchedule": {
      "Hourly": true,
      "Shift": true,
      "Daily": true,
      "Weekly": true,
      "Monthly": true
    },
    "ShiftDurationHours": 8
  },

  "EnergyCalculation": {
    "SupplyVoltageV": 415,
    "PowerFactor": 0.85,
    "ActiveImpellerCount": 10
  },

  "MaintenanceThresholds": {
    "SpareNames": ["Blade", "Blade Mounting Piece", "Narrow Plate", "Curved Plate", "Feeding End", "Bearing End", "Impeller", "Wall Plate", "Control Gauge", "Disc Spacer", "Doom Nut 1/2in", "Doom Nut 5/8", "Disc", "Guide Plate"],
    "SpareLifeBlastHours": [100, 300, 300, 600, 2000, 2000, 300, 2000, 300, 0, 2000, 2000, 5000, 600]
  },

  "Calculation": {
    "RealTimeIntervalMs": 1000
  },

