<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the unified PLC gateway (Part E3). The ASP.NET Core Module V2 hosts the app
  in-process. IMPORTANT: the app pool must be configured Start Mode = AlwaysRunning,
  Idle Time-out = 0, and the site Preload Enabled, so IIS never idles the PLC scan pipeline.
  See DEPLOYMENT-NOTES.md.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\PLCGateway.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="InProcess" />
    </system.webServer>
  </location>
</configuration>
